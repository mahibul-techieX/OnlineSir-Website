# Set these in your publisher environment or GitHub Actions secrets.
# Never commit real values. Worker secrets are configured separately with wrangler secret put.
ADMIN_API_URL=https://onlinesir.in
RELEASE_EXPORT_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT_NAME=onlinesir
# Optional serverless publisher: Worker variables GITHUB_PUBLISH_REPO=owner/repo,
# GITHUB_PUBLISH_BRANCH=main; Worker secret GITHUB_PUBLISH_TOKEN (Actions:write).
# Private media repo: Worker variable GITHUB_MEDIA_REPO; secret GITHUB_MEDIA_TOKEN (Contents:write).
