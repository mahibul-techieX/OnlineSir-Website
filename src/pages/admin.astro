---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import '../styles/admin.css';
const tabs=[['overview','Overview','grid'],['notes','Notes & solutions','file'],['curriculum','Curriculum','book'],['media','Media library','file'],['publishing','Publishing','globe'],['corrections','Corrections','check'],['settings','Site settings','menu'],['team','Team access','shield'],['backups','Backups','bookmark'],['activity','Activity log','clock']];
---
<Layout title="Content studio" noindex><div class="studio" lang="en"><aside class="studio-nav"><div class="studio-brand"><span class="studio-mark"><Icon name="book"/></span><div><strong>Content studio</strong><small>ONLINE SIR</small></div></div><nav aria-label="Admin sections">{tabs.map(([id,label,icon])=><a href={`#${id}`} data-section={id}><Icon name={icon} size={19}/>{label}</a>)}</nav><a class="studio-view" href="/" target="_blank" rel="noopener">View website <Icon name="arrow" size={17}/></a></aside><div class="studio-main"><div class="studio-top"><div><div class="eyebrow">CREATE · REVIEW · PUBLISH</div><h1 id="section-title">Notes & solutions</h1></div><div class="studio-user"><span id="user-label">Connecting…</span><a id="logout" href="/cdn-cgi/access/logout" hidden>Sign out</a></div></div><div id="connection" class="admin-config" role="status">Connecting to your editorial workspace…</div><p id="global-message" class="feedback" role="status" aria-live="polite"></p>
<section data-panel="overview" hidden><div id="overview-stats" class="studio-stats"></div><div class="admin-panel editor"><h2>Your publishing checklist</h2><ol class="checklist"><li>Set up classes, subjects, textbooks and chapters in Curriculum.</li><li>Write notes or upload teaching resources in the editor.</li><li>Review the preview and approve accurate content.</li><li>Prepare a release, then publish it. Existing approved notes remain available while you edit new drafts.</li></ol><a href="#notes" class="button primary">Create a lesson <Icon name="arrow" size={17}/></a></div></section>
<section data-panel="notes"><div class="studio-actions"><div class="filter-bar"><label class="sr-only" for="note-search">Find notes</label><input id="note-search" type="search" placeholder="Search your notes…"/><label class="sr-only" for="note-status">Status</label><select id="note-status"><option value="active">Active notes</option><option value="">All statuses</option><option value="draft">Draft</option><option value="review">In review</option><option value="approved">Approved</option><option value="archived">Archived</option></select><button id="refresh-list" class="button secondary">Refresh</button></div><button id="new-note" class="button primary"><Icon name="plus" size={17}/> New note</button></div><div class="studio-editor-layout"><section class="admin-panel"><div class="panel-heading"><h2>Your resources</h2><span id="resource-count" class="quiet-pill">0</span></div><div id="admin-list" class="studio-list"></div><div class="list-pagination"><button id="previous-page" class="button secondary">Previous</button><button id="next-page" class="button secondary">Next</button></div></section><section class="admin-panel"><div class="panel-heading"><h2 id="editor-title">New note</h2><span id="editor-state" class="quiet-pill">Draft</span></div><form id="editor" class="editor"><fieldset id="editor-fields" class="reset-fieldset" disabled><div class="editor-grid"><label class="field full-width">Curriculum chapter<select name="chapterId"><option value="">Enter details manually</option></select></label><label class="field full-width">Title<input name="title" required maxlength="180" placeholder="অসমীয়াত পাঠৰ শিৰোনাম লিখক"/></label><label class="field">Class<select name="grade">{[5,6,7,8,9,10].map(g=><option value={g}>Class {g}</option>)}</select></label><label class="field">Resource type<select name="type"><option value="notes">Text notes</option><option value="solution">Chapter solution</option></select></label><label class="field">Subject name<input name="subjectTitle" required maxlength="80" placeholder="গণিত"/></label><label class="field">Subject URL slug<input name="subject" required maxlength="70" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="mathematics"/></label><label class="field">Textbook / collection<input name="book" required maxlength="180"/></label><label class="field">Academic session / edition<input name="edition" required maxlength="30" value="2026-27"/></label><label class="field">Chapter<input name="chapter" required maxlength="180"/></label><label class="field">Page URL slug<input name="slug" required maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="real-numbers"/></label><label class="field full-width">Short description<textarea name="description" required maxlength="400" rows="2"></textarea></label><div class="full-width"><label for="note-body" class="field">Your note</label><div class="editor-toolbar" role="toolbar" aria-label="Text formatting"><button type="button" data-format="heading">Heading</button><button type="button" data-format="bold"><b>Bold</b></button><button type="button" data-format="italic"><i>Italic</i></button><button type="button" data-format="list">List</button><button type="button" data-format="table">Table</button><button type="button" id="insert-media">Attach media</button><button type="button" id="import-text">Import text</button><button type="button" id="toggle-preview">Preview</button></div><label class="field"><span class="sr-only">Note text</span><textarea id="note-body" name="body" required maxlength="100000" placeholder="ইয়াত আপোনাৰ টোকা লিখক…"></textarea></label><div id="note-preview" class="preview-pane prose" hidden></div><div class="editor-meta"><span id="word-count">0 words</span><label><input id="autosave" type="checkbox" checked/> Autosave valid drafts</label></div><input id="text-file" type="file" accept=".txt,.md" hidden/></div><details class="full-width"><summary>Search appearance</summary><label class="field">SEO title (optional)<input name="seoTitle" maxlength="180"/></label><label class="field">SEO description (optional)<textarea name="seoDescription" maxlength="400" rows="2"></textarea></label></details><label class="checkbox-field full-width"><input name="sample" type="checkbox"/> Label as sample content</label></div><div class="editor-actions"><button id="save-note" class="button primary" type="submit">Save draft</button><button id="review-note" class="button secondary" type="button">Send to review</button><button id="approve-note" class="button green" type="button">Approve</button><button id="archive-note" class="button danger" type="button">Archive</button></div><div class="editor-actions secondary-actions"><button id="duplicate-note" class="button secondary" type="button">Duplicate</button><button id="history-note" class="button secondary" type="button">Revision history</button><button id="download-note" class="button secondary" type="button">Export text</button></div></fieldset><p id="editor-message" class="feedback" role="status"></p></form></section></div></section>
<section data-panel="curriculum" hidden><div class="studio-actions"><p class="muted">Classes → subjects → textbooks → chapters</p><button id="add-curriculum" class="button primary">Add curriculum item</button></div><div id="curriculum-list" class="admin-panel editor"></div></section>
<section data-panel="media" hidden><div class="studio-actions"><p class="muted">Images up to 2 MB · PDFs up to 5 MB</p><button id="upload-media" class="button primary">Upload file</button></div><div id="media-list" class="media-grid"></div></section>
<section data-panel="publishing" hidden><div class="admin-panel editor"><h2>Publish your approved work</h2><p class="muted">Prepare a fixed snapshot, then publish it. Edits to a draft preserve the previously approved version. Archived notes are excluded from new releases.</p><div class="editor-actions"><button id="prepare-release" class="button primary">Prepare release</button><button id="refresh-releases" class="button secondary">Refresh status</button></div><p id="release-message" class="feedback" role="status"></p></div><div id="releases" class="release-list"></div></section>
<section data-panel="corrections" hidden><div class="studio-actions"><p class="muted">Track editorial feedback and follow it through.</p><button id="add-correction" class="button primary">Log correction</button></div><div id="correction-list"></div></section>
<section data-panel="settings" hidden><form id="settings-form" class="admin-panel editor"><h2>Website settings</h2><p class="muted">Changes appear on the public website after the next release.</p><div class="editor-grid"><label class="field">Site name<input name="siteName" required maxlength="80"/></label><label class="field">Academic session<input name="academicSession" required maxlength="30"/></label><label class="field full-width">Tagline<input name="tagline" required maxlength="200"/></label><label class="field full-width">Contact email<input name="contactEmail" type="email" maxlength="200"/></label><label class="field full-width">Announcement<textarea name="announcement" maxlength="500" rows="3"></textarea></label></div><div class="editor-actions"><button class="button primary">Save settings</button></div><p class="feedback" id="settings-message" role="status"></p></form></section>
<section data-panel="team" hidden><div class="studio-actions"><p class="muted">Editors write drafts. Reviewers approve and publish. Only the owner manages access and backups.</p><button id="add-user" class="button primary">Add team member</button></div><div class="notice">Team members also need to be allowed by your Cloudflare Access policy. Local development uses the owner identity.</div><div id="team-list" class="admin-panel editor"></div></section>
<section data-panel="backups" hidden><div class="admin-panel editor"><h2>Keep a copy of your work</h2><p class="muted">Download a ZIP containing database records and uploaded files. Account credentials and team access are excluded.</p><div class="editor-actions"><button id="download-backup" class="button primary">Download complete backup</button><button id="restore-backup" class="button secondary">Restore missing records</button></div><input id="backup-file" type="file" accept=".zip" hidden/><p class="feedback" id="backup-message" role="status"></p><p class="editor-hint">Restore adds missing data without overwriting existing notes. Keep backups on another device. A restored file uses the same URL as its original.</p></div></section>
<section data-panel="activity" hidden><div class="studio-actions"><p class="muted">A record of edits, reviews and publishing actions.</p><button id="refresh-activity" class="button secondary">Refresh</button></div><div id="activity-list" class="admin-panel editor"></div></section>
</div></div><dialog id="studio-dialog"><div class="dialog-header"><h2 id="dialog-title"></h2><button id="close-dialog" class="button secondary" aria-label="Close dialog">Close</button></div><div id="dialog-body"></div></dialog><script src="../scripts/admin.ts"></script></Layout>
