---
import Layout from '../layouts/Layout.astro';
import {booksFor,bookPath} from '../lib/catalog.mjs';
import Icon from '../components/Icon.astro';
import ResourceCard from '../components/ResourceCard.astro';
import {grades,asNumber,resources,subjectsFor,pathFor,renderContent} from '../lib/content.mjs';
export function getStaticPaths(){
 return grades.flatMap(grade=>[
 {params:{path:`class-${grade}`},props:{kind:'class',grade}},
 ...subjectsFor(grade).map(subject=>({params:{path:`class-${grade}/${subject.slug}`},props:{kind:'subject',grade,subject}})),
 ...resources.filter(r=>r.grade===grade).map(resource=>({params:{path:pathFor(resource).slice(1,-1)},props:{kind:'resource',grade,resource}}))]);
}
const {kind,grade,subject,resource:r}=Astro.props;
const list=resources.filter(x=>x.grade===grade && (!subject || x.subject===subject.slug));
const title=kind==='resource'?r.title:kind==='subject'?subject.title:`${asNumber(grade)} শ্ৰেণীৰ পাঠ`;
---
<Layout title={kind==='resource'?(r.seoTitle||title):title} description={kind==='resource'?(r.seoDescription||r.description):undefined} noindex={kind==='resource' && r.sample}><div class="container page-section"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">মুখ্য পৃষ্ঠা</a><span>/</span>{kind==='class'?<span>শ্ৰেণী {asNumber(grade)}</span>:<><a href={`/class-${grade}/`}>শ্ৰেণী {asNumber(grade)}</a><span>/</span><span>{kind==='resource'?r.subjectTitle:subject.title}</span></>}</nav>
{kind!=='resource'?<><div class="page-intro"><div class="eyebrow">নিজৰ গতিৰে শিকোঁ</div><h1>{title}</h1><p>{kind==='class'?'আপোনাৰ বিষয় বাছি লওক। উপলব্ধ পাঠ আৰু টোকাসমূহ ইয়াতে পাব।':'পাঠৰ টোকা আৰু সমাধানসমূহ অন্বেষণ কৰক।'}</p></div>{kind==='class' && <div class="subject-grid">{subjectsFor(grade).map(s=><a class="subject-card" href={`/class-${grade}/${s.slug}/`}><span class="subject-icon"><Icon name="book" size={27}/></span><div><h2>{s.title}</h2><p>{asNumber(list.filter(x=>x.subject===s.slug).length)} টা পাঠ উপলব্ধ</p></div><Icon name="arrow"/></a>)}</div>}{kind==='subject' && <div class="subject-grid">{booksFor(list).map(book=><a class="subject-card" href={book.url}><div><h2>{book.book}</h2><p>{book.edition}</p></div><Icon name="arrow"/></a>)}</div>}{list.length?<><h2 class="list-title">উপলব্ধ পাঠ</h2><div class="resource-grid">{list.map(x=><ResourceCard resource={x}/>)}</div></>:<div class="empty-state"><Icon name="book" size={44}/><h2>নতুন পাঠ আহি আছে</h2><p>এই শ্ৰেণীৰ পৰ্যালোচিত টোকা এতিয়াও প্ৰকাশ কৰা হোৱা নাই।</p><a class="button primary" href="/#classes">অন্য শ্ৰেণী চাওক</a></div>}</>:<div class="reader-layout"><aside class="reader-aside"><a class="back-link" href={`/class-${grade}/${r.subject}/`}>← {r.subjectTitle}</a><h3>এই বিষয়ৰ পাঠ</h3>{resources.filter(x=>x.grade===grade&&x.subject===r.subject).map(x=><a class:list={['reader-nav',{selected:x.id===r.id}]} href={pathFor(x)}>{x.title}</a>)}<div class="reader-tip"><Icon name="bookmark"/><p>পাছত পঢ়িবলৈ এই পাঠটো সাঁচি ৰাখিব পাৰে।</p></div></aside><article class="reading-card" data-pagefind-body><span hidden data-pagefind-meta="grade" data-pagefind-filter="grade">{r.grade}</span><span hidden data-pagefind-meta="type" data-pagefind-filter="type">{r.type}</span><span hidden data-pagefind-meta="subjectTitle">{r.subjectTitle}</span><span hidden>{r.subject} {r.slug}</span><div class="eyebrow">শ্ৰেণী {asNumber(grade)} · {r.subjectTitle} · {r.type==='solution'?'সমাধান':'টোকা'}</div><h1 data-pagefind-meta="title">{r.title}</h1><p class="reading-description" data-pagefind-meta="description">{r.description}</p><div class="reading-meta"><span><Icon name="clock" size={17}/> {r.edition}</span><a href={bookPath(r)}>{r.book} · {r.edition}</a><span>{r.chapter}</span></div>{r.sample && <div class="notice">নমুনা পাঠ — এই বিষয়বস্তু পাঠ্যপুথিৰ যাচাইকৃত সমাধান নহয়।</div>}<div class="reader-actions" data-pagefind-ignore><button id="save-resource" class="button secondary" data-id={r.id} data-title={r.title} data-url={pathFor(r)} aria-pressed="false"><Icon name="bookmark" size={18}/><span>সাঁচি ৰাখক</span></button><button class="button secondary" id="print-resource">প্ৰিণ্ট কৰক</button><button class="button secondary" id="copy-resource">লিংক কপি কৰক</button></div><p id="reader-feedback" class="feedback" role="status"></p><div class="prose" set:html={renderContent(r.body)}></div><div class="reading-end"><Icon name="check"/><span>আজি এখোজ আগবাঢ়িল!</span><a href={`/class-${grade}/${r.subject}/`}>অন্য পাঠ চাওক →</a></div></article></div>}
</div><script>
const save=document.querySelector<HTMLButtonElement>('#save-resource');
const message=document.querySelector('#reader-feedback');
const feedback=(s:string)=>{if(message)message.textContent=s;};
if(save){
 const get=()=>{try{return JSON.parse(localStorage.getItem('onlinesir-saved')||'[]');}catch{return [];}};
 const refresh=()=>{const exists=get().some((x:any)=>x.id===save.dataset.id);save.setAttribute('aria-pressed',String(exists));save.querySelector('span')!.textContent=exists?'সাঁচি থোৱা হৈছে':'সাঁচি ৰাখক';};refresh();
 save.onclick=()=>{try{let all=get();const exists=all.some((x:any)=>x.id===save.dataset.id);all=exists?all.filter((x:any)=>x.id!==save.dataset.id):[...all,{id:save.dataset.id,title:save.dataset.title,url:save.dataset.url}];localStorage.setItem('onlinesir-saved',JSON.stringify(all));refresh();feedback(exists?'সাঁচি থোৱা তালিকাৰ পৰা আঁতৰোৱা হ’ল।':'এই ডিভাইচত পাঠটো সাঁচি ৰখা হ’ল।');}catch{feedback('এই ব্ৰাউজাৰত সাঁচি ৰাখিব পৰা নগ’ল।');}};
}
document.querySelector('#print-resource')?.addEventListener('click',()=>window.print());
document.querySelector('#copy-resource')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.href);feedback('লিংক কপি কৰা হ’ল।');}catch{feedback('ব্ৰাউজাৰৰ ঠিকনাৰ পৰা লিংকটো কপি কৰক।');}});
</script></Layout>
