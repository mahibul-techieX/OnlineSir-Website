---
import Layout from '../layouts/Layout.astro';
---
<Layout title="সাঁচি থোৱা পাঠ" noindex><div class="container page-section"><div class="page-intro"><div class="eyebrow">পুনৰ পঢ়িবলৈ</div><h1>সাঁচি থোৱা পাঠ</h1><p>এই ব্ৰাউজাৰত সাঁচি ৰখা পাঠসমূহ। ব্ৰাউজাৰৰ তথ্য মচিলে এই তালিকাও মচি যাব।</p></div><div id="saved-list" class="saved-list"></div><div id="saved-empty" class="empty-state"><h2>এতিয়াও কোনো পাঠ সাঁচি থোৱা নাই</h2><p>পাঠ পঢ়োঁতে “সাঁচি ৰাখক” বুটামটো ব্যৱহাৰ কৰক।</p><a class="button primary" href="/search/">পাঠ বিচাৰক</a></div></div><script>
function render(){let items=[];try{items=JSON.parse(localStorage.getItem('onlinesir-saved')||'[]');}catch{}const list=document.querySelector('#saved-list')!;list.replaceChildren();for(const item of items){if(typeof item.url!=='string'||!/^\/class-\d+\/[a-z0-9-]+\/[a-z0-9-]+\/$/.test(item.url))continue;const row=document.createElement('div');row.className='saved-item';const link=document.createElement('a');link.textContent=item.title;link.href=item.url;const remove=document.createElement('button');remove.className='button secondary';remove.textContent='আঁতৰাওক';remove.onclick=()=>{try{localStorage.setItem('onlinesir-saved',JSON.stringify(items.filter((x:any)=>x.id!==item.id)));render();}catch{remove.textContent='সাঁচি ৰাখিব পৰা নগ’ল';}};row.append(link,remove);list.append(row);}document.querySelector<HTMLElement>('#saved-empty')!.hidden=list.childElementCount>0;}render();
</script></Layout>
