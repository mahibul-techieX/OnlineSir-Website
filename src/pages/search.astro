---
import Layout from '../layouts/Layout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import {resources,grades,asNumber} from '../lib/content.mjs';
---
<Layout title="পাঠ বিচাৰক" noindex><div class="container page-section"><div class="breadcrumbs"><a href="/">মুখ্য পৃষ্ঠা</a><span>/</span><span>পাঠ বিচাৰক</span></div><div class="page-intro"><div class="eyebrow">শিকিবলৈ নতুন কিবা</div><h1>আপোনাৰ পাঠ বিচাৰি লওক</h1><p>অসমীয়া বা ইংৰাজীত বিষয়, পাঠ অথবা মূল শব্দ লিখক।</p></div><form id="search-form" class="search-controls"><label class="field">কি বিচাৰিছে?<input id="query" type="search" name="q" placeholder="উদাহৰণ: গণিত, fractions…"/></label><label class="field">শ্ৰেণী<select id="grade-filter"><option value="">সকলো শ্ৰেণী</option>{grades.map(g=><option value={g}>শ্ৰেণী {asNumber(g)}</option>)}</select></label><label class="field">ধৰণ<select id="type-filter"><option value="">সকলো পাঠ</option><option value="notes">টোকা</option><option value="solution">সমাধান</option></select></label></form><p class="search-count" id="result-count" role="status">{asNumber(resources.length)} টা পাঠ</p><div class="resource-grid" id="search-results">{resources.map(r=><div data-search={JSON.stringify(r)}><ResourceCard resource={r}/></div>)}</div><div id="no-results" class="empty-state" hidden><h2>মিল থকা পাঠ পোৱা নগ’ল</h2><p>অন্য শব্দ ব্যৱহাৰ কৰক অথবা শ্ৰেণীৰ ফিল্টাৰ সলনি কৰক।</p></div></div><script>
const query=document.querySelector<HTMLInputElement>('#query')!;const grade=document.querySelector<HTMLSelectElement>('#grade-filter')!;const type=document.querySelector<HTMLSelectElement>('#type-filter')!;
query.value=new URLSearchParams(location.search).get('q')||'';
function filter(){let count=0;const words=query.value.normalize('NFC').toLowerCase().trim().split(/\s+/).filter(Boolean);document.querySelectorAll<HTMLElement>('[data-search]').forEach(el=>{const r=JSON.parse(el.dataset.search!);const hay=[r.title,r.subjectTitle,r.subject,r.slug,r.chapter,r.description,r.body,r.grade].join(' ').normalize('NFC').toLowerCase();const match=words.every(w=>hay.includes(w))&&(!grade.value||r.grade===Number(grade.value))&&(!type.value||r.type===type.value);el.hidden=!match;if(match)count++;});document.querySelector('#result-count')!.textContent=`${count} টা পাঠ পোৱা গৈছে`;document.querySelector<HTMLElement>('#no-results')!.hidden=count>0;}
query.addEventListener('input',filter);grade.addEventListener('change',filter);type.addEventListener('change',filter);document.querySelector('#search-form')!.addEventListener('submit',e=>{e.preventDefault();history.replaceState(null,'',`?q=${encodeURIComponent(query.value)}`);filter();});filter();
</script></Layout>
