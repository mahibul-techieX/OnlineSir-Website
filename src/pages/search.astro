---
import Layout from '../layouts/Layout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import {resources,grades,asNumber} from '../lib/content.mjs';
---
<Layout title="পাঠ বিচাৰক" noindex><div class="container page-section"><div class="breadcrumbs"><a href="/">মুখ্য পৃষ্ঠা</a><span>/</span><span>পাঠ বিচাৰক</span></div><div class="page-intro"><div class="eyebrow">শিকিবলৈ নতুন কিবা</div><h1>আপোনাৰ পাঠ বিচাৰি লওক</h1><p>অসমীয়া বা ইংৰাজীত বিষয়, পাঠ অথবা মূল শব্দ লিখক।</p></div><form id="search-form" class="search-controls"><label class="field">কি বিচাৰিছে?<input id="query" type="search" name="q" placeholder="উদাহৰণ: গণিত, fractions…"/></label><label class="field">শ্ৰেণী<select id="grade-filter"><option value="">সকলো শ্ৰেণী</option>{grades.map(g=><option value={g}>শ্ৰেণী {asNumber(g)}</option>)}</select></label><label class="field">ধৰণ<select id="type-filter"><option value="">সকলো পাঠ</option><option value="notes">টোকা</option><option value="solution">সমাধান</option></select></label></form><p class="search-count" id="result-count" role="status">{asNumber(resources.length)} টা পাঠ</p><div class="resource-grid" id="search-results">{resources.slice(0,24).map(r=><div data-search=""><ResourceCard resource={r}/></div>)}</div><button id="more-results" class="button secondary" style="margin-top:24px" hidden>আৰু পাঠ চাওক</button><div id="no-results" class="empty-state" hidden><h2>মিল থকা পাঠ পোৱা নগ’ল</h2><p>অন্য শব্দ ব্যৱহাৰ কৰক অথবা শ্ৰেণীৰ ফিল্টাৰ সলনি কৰক।</p></div></div><script id="search-seed" type="application/json" set:html={JSON.stringify(resources.map(({body,...r})=>({...r,url:`/class-${r.grade}/${r.subject}/${r.slug}/`}))).replace(/</g,'\u003c')}></script><script src="../scripts/search.ts"></script></Layout>
