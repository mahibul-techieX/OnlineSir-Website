---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ResourceCard from '../components/ResourceCard.astro';
import {grades,asNumber,resources} from '../lib/content.mjs';
---
<Layout><section class="hero"><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow"><span class="status-dot"></span> আপোনাৰ শিক্ষাৰ নতুন ঠিকনা</div><h1>শিকাৰ আনন্দ,<br/><span>নিজৰ ভাষাত।</span></h1><p class="hero-description">পঞ্চমৰ পৰা দশম শ্ৰেণীলৈ পাঠৰ টোকা আৰু সহজ সমাধান। অসমীয়া মাধ্যমৰ শিক্ষাৰ যাত্ৰাত আপোনাৰ সহযাত্ৰী।</p><form action="/search/" class="hero-search" role="search"><Icon name="search"/><label for="home-search" class="sr-only">বিষয় বা পাঠ বিচাৰক</label><input id="home-search" name="q" placeholder="কি শিকিব বিচাৰে? বিষয় বা পাঠ বিচাৰক…"/><button type="submit">বিচাৰক <Icon name="arrow" size={19}/></button></form><div class="popular"><span>জনপ্ৰিয় বিষয়:</span><a href="/search/?q=গণিত">গণিত</a><a href="/search/?q=বিজ্ঞান">বিজ্ঞান</a><a href="/search/?q=ইংৰাজী">ইংৰাজী</a></div></div><div class="hero-art" aria-label="পাঠৰ টোকাৰ উদাহৰণ"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="floating-label"><span class="round-icon"><Icon name="check" size={19}/></span> সহজ ভাষাত, স্পষ্ট ধাৰণা</div><div class="study-card"><div class="study-card-top"><span class="study-icon"><Icon name="book" size={26}/></span><span>আজি অলপ শিকোঁ<br/><small>প্ৰতিটো পাঠ, এখোজ আগলৈ</small></span><span class="mini-dots">•••</span></div><div class="study-rule"></div><span class="study-kicker">গণিত · শ্ৰেণী ১০</span><h2>সৰু সৰু খোজেৰে<br/>ডাঙৰ সপোনলৈ।</h2><div class="formula">a² + b² + 2ab <span>= (a + b)²</span></div><div class="study-line"></div><div class="study-line short"></div><div class="study-card-bottom"><span><Icon name="file" size={17}/> পাঠভিত্তিক টোকা</span><Icon name="arrow"/></div></div><div class="floating-book"><Icon name="book" size={32}/></div><div class="floating-language"><Icon name="globe" size={19}/> অসমীয়াত শিকোঁ</div><span class="art-plus plus-one">+</span><span class="art-plus plus-two">+</span></div></div></section>
<div class="benefit-strip"><div class="container benefits"><div><Icon name="book"/><span>পাঠভিত্তিক শিক্ষা</span></div><div><Icon name="globe"/><span>সহজ অসমীয়া ভাষা</span></div><div><Icon name="file"/><span>টোকা আৰু সমাধান</span></div><div><Icon name="shield"/><span>বিনামূলীয়া প্ৰৱেশ</span></div></div></div>
<section id="classes" class="section container"><div class="section-heading"><div><div class="eyebrow">আপোনাৰ পৰা আৰম্ভ হওক</div><h2>আপুনি কোন শ্ৰেণীত পঢ়ে?</h2><p>শ্ৰেণী বাছক, বিষয় বাছক আৰু শিকিবলৈ আৰম্ভ কৰক।</p></div><span class="quiet-pill">শ্ৰেণী ৫ — ১০</span></div><div class="class-grid">{grades.map((grade,index)=><a href={`/class-${grade}/`} class="class-card"><span class="class-caption">CLASS {grade}</span><span class={`class-number tone-${index}`}>{asNumber(grade)}</span><h3>{['পঞ্চম','ষষ্ঠ','সপ্তম','অষ্টম','নৱম','দশম'][index]} শ্ৰেণী</h3><div class="class-link">পাঠ চাওক <Icon name="arrow" size={17}/></div></a>)}</div></section>
<section class="resources-section"><div class="container section"><div class="section-heading"><div><div class="eyebrow">অলপ পঢ়োঁ, নতুনকৈ শিকোঁ</div><h2>পাঠৰ টোকা অন্বেষণ কৰক</h2><p>পঢ়াৰ অভিজ্ঞতা চাবলৈ কিছুমান নমুনা পাঠ।</p></div><a class="text-link" href="/search/">সকলো পাঠ চাওক <Icon name="arrow" size={19}/></a></div><div class="resource-grid">{resources.slice(0,4).map(r=><ResourceCard resource={r}/>)}</div><p class="sample-disclosure">এই প্ৰাৰম্ভিক সংস্কৰণৰ নমুনা পাঠসমূহ পাঠ্যপুথিৰ যাচাইকৃত সমাধান নহয়। পৰ্যালোচিত পাঠ ক্ৰমে যোগ কৰা হ’ব।</p></div></section>
<section class="container section"><div class="learning-banner"><div class="banner-symbol"><Icon name="book" size={48}/></div><div><div class="eyebrow">এটা সহজ অভ্যাস, প্ৰতিদিনে</div><h2>আজিৰ পাঠ, কাইলৈৰ আত্মবিশ্বাস।</h2><p>নিজৰ সুবিধামতে পঢ়ক। প্ৰয়োজনীয় পাঠ সাঁচি ৰাখক আৰু আকৌ এবাৰ চাওক।</p></div><a class="button primary" href="/saved/">সাঁচি থোৱা পাঠ <Icon name="bookmark" size={18}/></a></div></section></Layout>
