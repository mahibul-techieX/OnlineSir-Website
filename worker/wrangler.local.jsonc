 "vars":{"LOCAL_DEVELOPMENT":"true","APP_ORIGIN":"http://127.0.0.1:4321"},
 "d1_databases":[{"binding":"DB","database_name":"onlinesir","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
 "r2_buckets":[{"binding":"MEDIA","bucket_name":"onlinesir-local-media"}]
}
