{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "onlinesir-admin",
  "main": "index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "vars": {
    "APP_ORIGIN": "https://onlinesir.in",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "support.onlinesir@gmail.com",
    "PUBLISH_RUNNER_ENABLED": "false",
    "AUTH_MODE": "password",
    "ADDITIONAL_APP_ORIGIN": "https://onlinesir.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onlinesir",
      "database_id": "eaab23fb-e158-4f25-ac0d-2be3e6596b67",
      "migrations_dir": "migrations"
    }
  ],
  "account_id": "8069225effa25b454a53ec21458b26f0"
}
