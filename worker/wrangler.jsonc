{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "onlinesir-admin",
  "main": "index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "vars": {
    "APP_ORIGIN": "https://onlinesir.in",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": ""
  },
  "d1_databases": [{"binding":"DB","database_name":"onlinesir","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}]
}
